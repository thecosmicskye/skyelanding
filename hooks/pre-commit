#!/bin/bash

# Auto cache-bust CSS on commit to main across all HTML files
BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$BRANCH" = "main" ]; then
  # Check if CSS or any HTML file is being committed
  if git diff --cached --name-only | grep -qE "(styles\.css|\.html$)"; then
    VERSION=$(date +%s)

    # Update the cache-bust parameter in every HTML file that references styles.css
    find . -type f -name "*.html" -not -path "./.git/*" -not -path "./node_modules/*" | while read -r file; do
      if grep -q "styles\.css?v=" "$file"; then
        sed -i '' "s|styles\.css?v=[0-9]*|styles.css?v=$VERSION|g" "$file"
        git add "$file"
      fi
    done
  fi
fi

exit 0
